rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isUsableAccount(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return u.status == 'active' && (
        u.role == 'admin' ||
        (u.subscription == 'trial' && u.trialEnd > request.time.toMillis()) ||
        (u.subscription != 'trial' && u.subscription != 'expired' && u.subscriptionEnd > request.time.toMillis())
      );
    }

    // Public pricing/feature configuration. It contains no secrets.
    match /settings/subscriptions {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && request.resource.data.subscription == 'trial';

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Admin may manage customer status/subscription/usage, but role is immutable.
      // A normal user may perform exactly one account activation after Firebase email verification.
      allow update: if (
          isAdmin() && request.resource.data.role == resource.data.role
        ) || (
          signedIn()
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && resource.data.role == 'user'
          && resource.data.status == 'pending'
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == 'active'
          && request.resource.data.subscription == 'trial'
          && request.resource.data.trialStart <= request.time.toMillis()
          && request.resource.data.trialStart >= resource.data.createdAt
          && request.resource.data.trialEnd == request.resource.data.trialStart + 259200000
          && request.resource.data.subscriptionStart == resource.data.subscriptionStart
          && request.resource.data.subscriptionEnd == resource.data.subscriptionEnd
        ) || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.subscription == resource.data.subscription
          && request.resource.data.trialStart == resource.data.trialStart
          && request.resource.data.trialEnd == resource.data.trialEnd
          && request.resource.data.subscriptionStart == resource.data.subscriptionStart
          && request.resource.data.subscriptionEnd == resource.data.subscriptionEnd
          && (
            request.resource.data.labelsGenerated >= resource.data.labelsGenerated
            || request.resource.data.usageMonth != resource.data.usageMonth
            || !('labelsGenerated' in resource.data)
          )
        );

      allow delete: if isAdmin() && resource.data.role != 'admin';

      match /projects/{projectId} {
        allow read, create, update, delete: if isAdmin()
          || (signedIn() && request.auth.uid == userId && isUsableAccount(userId));
      }
    }

    // Private label library: every account has its own label records.
    // A user can only read/write labels inside their own users/{uid}/labels collection.
    match /users/{userId}/labels/{labelId} {
      allow read: if signedIn()
        && request.auth.uid == userId
        && isUsableAccount(userId);

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isUsableAccount(userId)
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if signedIn()
        && request.auth.uid == userId
        && isUsableAccount(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
